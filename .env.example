# StoryForge AI - Environment Configuration
# Copy this file to .env and customize

# Application
APP_NAME="StoryForge AI - Cinematic Storytelling Engine"
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./storyforge.db

# LLM Provider (Ollama - Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Optional Cloud LLM / Vision (Gemini)
GEMINI_API_KEY=

# Image Generation - Cloudflare Workers AI (FLUX.1-Schnell)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Image Generation - Local ComfyUI (alternative)
COMFYUI_URL=http://localhost:8188
COMFYUI_ENABLED=false

# Stable Diffusion WebUI API (alternative)
SD_API_URL=http://localhost:7860
SD_API_ENABLED=false

# TTS - Piper (local)
PIPER_ENABLED=true
PIPER_MODEL_PATH=./assets/voices/piper

# TTS - Edge TTS (free neural multi-speaker cloud)
EDGE_TTS_ENABLED=true
EDGE_TTS_DEFAULT_VOICE=en-US-AriaNeural

# Voice - faster-whisper (for subtitle alignment)
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# YouTube API (optional for publishing)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5173/auth/youtube/callback

# Storage paths
ASSETS_DIR=./backend/storage/assets
OUTPUTS_DIR=./backend/storage/outputs
TEMP_DIR=./backend/storage/temp

# Video defaults (9:16 Vertical Shorts / Reels)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac

# Max concurrent rendering jobs
MAX_CONCURRENT_JOBS=2
